{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "Jwt": {
      "Issuer": "CharityDonationsApp",
      "Audience": "CharityDonationsApp",
      "ExpireMinutes": 15,
      "RefreshTokenExpireDays": 7
    },
    "Authentication": {
      "MaxFailedAttempts": 3,
      "BaseLockoutMinutes": 15,
      "LockoutMultiplier": 2,
      "MaxLockoutMinutes": 240
    }
  }
}
